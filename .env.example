# Majina ya settings tu. USIWEKE siri hapa.
HF_REPO=                      # GitHub repository VARIABLE: jina la dataset PRIVATE (user/name). Hakuna default.
HF_TOKEN=                     # GitHub SECRET: write access ya dataset hiyo tu
GDRIVE_SERVICE_ACCOUNT_JSON=  # GitHub SECRET: service account yenye ruhusa ya kusoma folders
ENABLE_CONVERSION=false       # GitHub repository VARIABLE: true tu baada ya mmiliki kuhakiki approved_items.json
CF_ACCOUNT_ID=                # GitHub VARIABLE
D1_DATABASE_ID=               # GitHub VARIABLE
CF_API_TOKEN=                 # GitHub SECRET: D1 Edit permission tu
